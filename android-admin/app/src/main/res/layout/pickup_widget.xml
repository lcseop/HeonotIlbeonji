<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical">
        <LinearLayout android:id="@+id/widget_header" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical">
            <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/heonot_logo" android:contentDescription="헌옷일번지" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="헌옷일번지" android:textColor="#18334E" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="새 신청 · 연락 완료" android:textColor="#43566A" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/widget_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginHorizontal="6dp" android:text="0건" android:textColor="#18334E" android:textSize="13sp" android:textStyle="bold" />
        </LinearLayout>
        <ImageButton android:id="@+id/widget_refresh" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp" android:src="@drawable/ic_material_refresh" android:background="@android:color/transparent" android:contentDescription="신청 목록 새로고침" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <ListView android:id="@+id/widget_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="#DEE5EB" android:dividerHeight="1dp" android:scrollbars="vertical" />
        <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="12dp" android:text="앱에서 로그인해 주세요" android:textColor="#43566A" android:textSize="14sp" />
    </FrameLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp" android:text="희망 날짜순" android:textColor="#596C7B" android:textSize="10sp" android:maxLines="2" />
</LinearLayout>
