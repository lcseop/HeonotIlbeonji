<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="헌옷일번지 · 관리자" Width="1320" Height="880" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" Background="#F3F6FA" Foreground="#18334E" FontFamily="Malgun Gothic" FontSize="14">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#EAF0F7"/><Setter Property="Foreground" Value="#18334E"/><Setter Property="BorderThickness" Value="0"/><Setter Property="MinHeight" Value="40"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="BorderBrush" Value="#CCD7E2"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="RowHeight" Value="44"/><Setter Property="ColumnHeaderHeight" Value="44"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeaderWidth" Value="0"/><Setter Property="SelectionMode" Value="Single"/><Setter Property="SelectionUnit" Value="FullRow"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="AlternatingRowBackground" Value="#F8FAFD"/><Setter Property="FontSize" Value="13"/><Setter Property="AutoGenerateColumns" Value="False"/></Style>
  <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#EAF0F7"/><Setter Property="Foreground" Value="#52687B"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Background="#F3F6FA">
  <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#16324C"><Grid Margin="20,28,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><Border Background="White" CornerRadius="12" Padding="12"><StackPanel Orientation="Horizontal"><Image x:Name="Logo" Width="34" Height="40" Margin="0,0,10,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="헌옷일번지" FontWeight="Bold" FontSize="17"/><TextBlock Text="관리자 데스크" FontSize="11" Foreground="#647A8C"/></StackPanel></StackPanel></Border><TextBlock Text="내 비즈니스 한눈에" Foreground="#9CB3C8" FontSize="12" Margin="4,24,0,16"/></StackPanel>
   <StackPanel x:Name="Navigation" Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Top"/>
   <StackPanel Grid.Row="2"><TextBlock Text="헌옷일번지 관리자 1.0.0" FontSize="11" Foreground="#A6BBD0"/><TextBlock Text="Windows 전용 · 안전한 관리자 연결" Margin="0,6,0,14" FontSize="10" Foreground="#A6BBD0"/><Button x:Name="OpenSite" Content="홈페이지 열기 ↗" Background="#284761" Foreground="White" Margin="0,0,0,8"/><Button x:Name="Logout" Content="로그아웃" Background="#284761" Foreground="White" Margin="0"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="30,26,30,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="오늘의 현황" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="Subtitle" Text="홈페이지와 수거 업무의 흐름을 확인하세요." Foreground="#647A8C" Margin="0,7,0,18"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><ComboBox x:Name="Month" Width="125" Margin="0,0,8,0"/><Button x:Name="Reload" Content="↻ 새로고침" Background="#18334E" Foreground="White" Margin="0"/></StackPanel></Grid>
   <Border x:Name="StatusBox" Grid.Row="1" Background="#E4EDF6" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"><DockPanel><ProgressBar x:Name="Progress" Width="75" Height="5" IsIndeterminate="True" DockPanel.Dock="Right" Visibility="Collapsed" Margin="16,0,0,0"/><TextBlock x:Name="Status" Text="로그인해 주세요." TextWrapping="Wrap" FontSize="12"/></DockPanel></Border>
   <Grid x:Name="Content" Grid.Row="2"/>
   <TextBlock Grid.Row="3" x:Name="Footnote" Text="한국 시간 기준 · 60초마다 현황 자동 확인" FontSize="11" Foreground="#647A8C" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
